#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>
int isPrime(int n) {
   int i;
   if (n <= 1)
      return 0;
   for (i = 2; i <= n / 2; i++) {
      if (n % i == 0)
         return 0;
   }
   return 1;
}
int main() {
   int arr[100], n, i;
   pid_t p2;
   printf("enter a size of array: ");
   if (scanf("%d", &n) != 1 || n <= 0 || n > 100) {
      printf("Invalid array size.\n");
      return 1;
   }
   printf("Enter %d elements:\n", n);
   for (i = 0; i < n; i++) {
      scanf("%d", &arr[i]);
   }
   p2 = fork();  
   if (p2 == -1) {
      printf("Process not created\n");
      return 1;
   } 
   else if (p2 == 0) {
      printf("\np2 (Child)\n");
      printf("PID: %d, PPID: %d\n", getpid(), getppid());
      
      printf("Prime numbers are: ");
      for (i = 0; i < n; i++) {
         if (isPrime(arr[i])) {
            printf("%d ", arr[i]);
         }
      }
      printf("\n");
      exit(0);
   } 
   else {
      wait(NULL);     
      printf("\np1 (Parent)\n");
      printf("PID: %d\n", getpid());
      return 0;
   }
}
