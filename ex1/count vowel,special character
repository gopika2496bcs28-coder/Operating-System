#include <stdio.h>
#include <unistd.h>
#include <string.h>
#include <ctype.h>
#include <sys/wait.h>
#include <stdlib.h>

int main() {
   char str[100];
   pid_t p2, p3;
   int i, vowels = 0, special = 0;
   printf("enter a string: ");
   fgets(str, sizeof(str), stdin);
   p2 = fork();
   
   if (p2 == -1) {
      printf("Process p2 could not be created\n");
      return 1;
   } 
   else if (p2 == 0) {
      for (i = 0; str[i] != '\0'; i++) {
         char ch = tolower((unsigned char)str[i]);
         if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
            vowels++;
         }
      }
      printf("\np2\n");
      printf("PID: %d\n", getpid());
      printf("PPID: %d\n", getppid());
      printf("Numbers of vowels: %d\n", vowels);
      exit(0); 
   } 
   else {
      p3 = fork();
      
      if (p3 == -1) {
         printf("Process p3 could not be created\n");
         return 1;
      } 
      else if (p3 == 0) {
         for (i = 0; str[i] != '\0'; i++) {
            if (!isalnum((unsigned char)str[i]) && !isspace((unsigned char)str[i])) {
               special++;
            }
         }
         printf("\np3\n");
         printf("PID: %d\n", getpid());
         printf("PPID: %d\n", getppid());
         printf("numbers of special character: %d\n", special);
         exit(0); 
      } 
      else {
         wait(NULL); 
         wait(NULL); 
         
         printf("\np1\n");
         printf("PID: %d\n", getpid());
         printf("PPID: %d\n", getppid());
      }
   }
   return 0;
}
