#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/types.h>
#include <unistd.h>
int main() {
    int shmid, *buf, i, num;
    int size = 10;
    shmid = shmget(4771, sizeof(int) * (size + 2), 0666);
    if (shmid == -1) {
        perror("shmget");
        return 1;
    }
    buf = (int *)shmat(shmid, NULL, 0);
    if (buf == (void *)-1) {
        perror("shmat");
        return 1;
    }
    printf("Data Read:\n");
    for (i = 0; i < size; i++) {
        num = buf[buf[11]];
        printf("%d\n", num);
        buf[11] = (buf[11] + 1) % size; 
    }
    shmdt(buf);
    shmctl(shmid, IPC_RMID, NULL);
    return 0;
}
